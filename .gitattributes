# Default: Git normalizes text on checkout according to the user platform.
# Do not run a bulk renormalize on existing files; new files should follow
# the rules below.
* text=auto

# Source, CMake, docs, and scripts: LF in the repository.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
CMakePresets.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.frag text eol=lf
*.vert text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.clang-format text eol=lf
.clang-tidy text eol=lf

# Visual Studio solution and project files stay CRLF.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (also gitignored in some directories).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp3 binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.zip binary
