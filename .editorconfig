# EditorConfig is used by many editors. It does not rewrite the Git history.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{vcxproj,vcxproj.filters,sln,props}]
end_of_line = crlf
indent_style = space

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
